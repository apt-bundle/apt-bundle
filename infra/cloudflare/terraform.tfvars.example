# Example Terraform variables file
# Copy this to terraform.tfvars for local testing (DO NOT commit terraform.tfvars)

# Find your Zone ID in Cloudflare Dashboard:
# 1. Log in to Cloudflare
# 2. Select your domain (apt-bundle.org)
# 3. Zone ID is shown in the right sidebar under "API" section
cloudflare_zone_id = "your-zone-id-here"

# Optional: Override defaults if needed
# domain = "apt-bundle.org"
# github_pages_target = "apt-bundle.github.io"

